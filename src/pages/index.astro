---
// Redirect to default locale (ES) with meta refresh for GitHub Pages compatibility
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0;url=/es/" />
    <link rel="canonical" href="/es/" />
    <title>Redirecting...</title>
    <script is:inline>
      window.location.href = '/es/';
    </script>
  </head>
  <body>
    <p>Redirecting to <a href="/es/">/es/</a>...</p>
  </body>
</html>
