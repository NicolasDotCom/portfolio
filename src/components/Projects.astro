---
import { getTranslations, getLocaleFromUrl } from '../i18n';
import ProjectCard from './ProjectCard.astro';

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);

const projects = [
  {
    title: 'E-commerce App',
    description: 'Full-stack e-commerce platform with cart, payments, and admin dashboard.',
    tags: ['React', 'Node.js', 'PostgreSQL'],
    image: 'https://picsum.photos/seed/ecommerce/800/600',
    link: '#',
    code: '#',
  },
  {
    title: 'Task Manager',
    description: 'Collaborative task management with real-time updates and team workspaces.',
    tags: ['Vue', 'Supabase', 'TypeScript'],
    image: 'https://picsum.photos/seed/taskmanager/800/600',
    link: '#',
    code: '#',
  },
  {
    title: 'Weather Dashboard',
    description: 'Beautiful weather app with forecasts, maps, and location-based alerts.',
    tags: ['Next.js', 'OpenWeather', 'Tailwind'],
    image: 'https://picsum.photos/seed/weather/800/600',
    link: '#',
    code: '#',
  },
  {
    title: 'Portfolio v1',
    description: 'First personal portfolio built with vanilla web technologies.',
    tags: ['HTML', 'CSS', 'JavaScript'],
    image: 'https://picsum.photos/seed/portfolio/800/600',
    link: '#',
    code: '#',
  },
  {
    title: 'REST API Boilerplate',
    description: 'Production-ready REST API with auth, validation, and documentation.',
    tags: ['Express', 'MongoDB', 'JWT'],
    image: 'https://picsum.photos/seed/api/800/600',
    link: '#',
    code: '#',
  },
  {
    title: 'Real-time Chat',
    description: 'WebSocket-based chat app with rooms, private messages, and file sharing.',
    tags: ['Socket.io', 'React', 'Redis'],
    image: 'https://picsum.photos/seed/chat/800/600',
    link: '#',
    code: '#',
  },
];
---

<section id="projects" class="section">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="reveal">
      <h2 class="text-3xl md:text-4xl font-bold mb-12 flex items-center gap-4">
        <span class="w-8 h-px bg-[var(--accent)]"></span>
        {t.projects.title}
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <ProjectCard {...project} />
      ))}
    </div>
  </div>
</section>
