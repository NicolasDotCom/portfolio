---
import { getTranslations, getLocaleFromUrl } from '../i18n';
import ProjectCard from './ProjectCard.astro';

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);

const projectImages: Record<string, string> = {
  'Sistema de Tickets de Soporte': 'https://picsum.photos/seed/tickets/800/600',
  'Support Ticket System': 'https://picsum.photos/seed/tickets/800/600',
  'Plataforma de Control de Inventarios': 'https://picsum.photos/seed/inventory/800/600',
  'Inventory Control Platform': 'https://picsum.photos/seed/inventory/800/600',
  'Sistema de Gestión Tes LTDA': 'https://picsum.photos/seed/tes/800/600',
  'Tes LTDA Management System': 'https://picsum.photos/seed/tes/800/600',
  'Portfolio Personal': 'https://picsum.photos/seed/portfolio/800/600',
  'Personal Portfolio': 'https://picsum.photos/seed/portfolio/800/600',
};

const projects = t.projects.items.map((project) => ({
  title: project.title,
  description: project.description,
  tags: project.tags,
  image: projectImages[project.title] || 'https://picsum.photos/seed/project/800/600',
  link: '#',
  code: '#',
}));
---

<section id="projects" class="section">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="reveal">
      <h2 class="text-3xl md:text-4xl font-bold mb-12 flex items-center gap-4">
        <span class="w-8 h-px bg-[var(--accent)]"></span>
        {t.projects.title}
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-2 gap-6">
      {projects.map((project) => (
        <ProjectCard {...project} />
      ))}
    </div>
  </div>
</section>