---
import { getTranslations, getLocaleFromUrl } from '../i18n';
import HeroShader from './shaders/HeroShader.astro';

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
---

<section id="home" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- WebGL Background -->
  <HeroShader />

  <!-- Content -->
  <div class="relative z-10 max-w-[1200px] mx-auto px-6 text-center">
    <p class="hero-greeting text-[var(--muted)] text-lg mb-4 opacity-0">
      {t.hero.greeting}
    </p>
    <h1 class="hero-name text-5xl md:text-7xl lg:text-8xl font-bold mb-6 opacity-0">
      {t.hero.name}
    </h1>
    <h2 class="hero-title text-2xl md:text-3xl lg:text-4xl font-semibold text-[var(--accent)] mb-6 opacity-0">
      {t.hero.title}
    </h2>
    <p class="hero-description text-[var(--muted)] text-lg md:text-xl max-w-xl mx-auto mb-10 opacity-0">
      {t.hero.description}
    </p>
    <div class="hero-cta opacity-0">
      <a href="#projects" class="magnetic-btn">
        {t.hero.cta}
        <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero-scroll absolute bottom-8 left-1/2 -translate-x-1/2 opacity-0">
    <div class="flex flex-col items-center gap-2 text-[var(--muted)]">
      <span class="text-xs mono">{t.hero.scroll}</span>
      <svg class="w-5 h-5 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </div>
</section>

<script>
  import { initHero } from '../scripts/hero';

  document.addEventListener('astro:page-load', initHero);
</script>
