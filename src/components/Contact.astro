---
import { getTranslations, getLocaleFromUrl } from '../i18n';
import { SITE } from '../consts';

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
---

<section id="contact" class="section">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="reveal">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 flex items-center gap-4">
        <span class="w-8 h-px bg-[var(--accent)]"></span>
        {t.contact.title}
      </h2>
      <p class="text-[var(--muted)] text-lg mb-12 max-w-lg">
        {t.contact.description}
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-12">
      <!-- Form -->
      <form class="reveal space-y-6" id="contact-form">
        <div>
          <label for="name" class="block text-sm text-[var(--muted)] mb-2">
            {t.contact.form.name}
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full px-4 py-3 bg-[var(--bg-subtle)] border border-[var(--border)] rounded-lg text-[var(--fg)] focus:border-[var(--accent)] focus:outline-none transition-colors"
          />
        </div>
        <div>
          <label for="email" class="block text-sm text-[var(--muted)] mb-2">
            {t.contact.form.email}
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-3 bg-[var(--bg-subtle)] border border-[var(--border)] rounded-lg text-[var(--fg)] focus:border-[var(--accent)] focus:outline-none transition-colors"
          />
        </div>
        <div>
          <label for="message" class="block text-sm text-[var(--muted)] mb-2">
            {t.contact.form.message}
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="w-full px-4 py-3 bg-[var(--bg-subtle)] border border-[var(--border)] rounded-lg text-[var(--fg)] focus:border-[var(--accent)] focus:outline-none transition-colors resize-none"
          ></textarea>
        </div>
        <button type="submit" class="magnetic-btn">
          {t.contact.form.send}
        </button>
      </form>

      <!-- Direct Contact -->
      <div class="reveal space-y-8">
        <div>
          <h3 class="mono text-sm text-[var(--muted)] uppercase tracking-wider mb-4">
            Email
          </h3>
          <a
            href={`mailto:${SITE.email}`}
            class="text-lg text-[var(--fg)] hover:text-[var(--accent)] transition-colors"
          >
            {SITE.email}
          </a>
        </div>

        <div>
          <h3 class="mono text-sm text-[var(--muted)] uppercase tracking-wider mb-4">
            Socials
          </h3>
          <div class="flex flex-col gap-3">
            <a
              href={SITE.github}
              target="_blank"
              rel="noopener"
              class="text-[var(--muted)] hover:text-[var(--fg)] transition-colors flex items-center gap-2"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              GitHub
            </a>
            <a
              href={SITE.linkedin}
              target="_blank"
              rel="noopener"
              class="text-[var(--muted)] hover:text-[var(--fg)] transition-colors flex items-center gap-2"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn
            </a>
            <a
              href={SITE.twitter}
              target="_blank"
              rel="noopener"
              class="text-[var(--muted)] hover:text-[var(--fg)] transition-colors flex items-center gap-2"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
              Twitter / X
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.getElementById('contact-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    // Placeholder: In production, integrate with Formspree, Resend, or similar
    alert('Message sent! (placeholder)');
  });
</script>
