---
import { getTranslations, getLocaleFromUrl } from '../i18n';
import { SITE } from '../consts';

const locale = getLocaleFromUrl(Astro.url);
const t = getTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--border)] py-8">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-sm text-[var(--muted)]">
        &copy; {year} {t.footer.rights}
      </p>
      <p class="text-sm text-[var(--muted)] flex items-center gap-1">
        {t.footer.madeWith}
        <svg class="w-4 h-4 text-[var(--accent)]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      </p>
    </div>
  </div>
</footer>
